<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net8.0-windows</TargetFramework>
    <RevitYear Condition="'$(RevitYear)' == ''">2026</RevitYear>
    <RevitPath Condition="'$(RevitPath)' == ''">C:\Program Files\Autodesk\Revit $(RevitYear)</RevitPath>
    <UseWindowsForms>true</UseWindowsForms><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="RevitAPI"><HintPath>$(RevitPath)\RevitAPI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="RevitAPIUI"><HintPath>$(RevitPath)\RevitAPIUI.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="CheckRevit" BeforeTargets="ResolveReferences"><Error Condition="!Exists('$(RevitPath)\RevitAPI.dll')" Text="Install Revit or set RevitPath to the matching official API assemblies." /></Target>
</Project>
